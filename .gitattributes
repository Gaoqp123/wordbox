# 换行符策略：仓库内统一 LF，检出也用 LF，与 .editorconfig 保持一致
* text=auto eol=lf

# Windows 脚本必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.exe binary
*.dll binary
*.node binary
*.zip binary
